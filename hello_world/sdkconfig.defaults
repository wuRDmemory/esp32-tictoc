# ESP32-PICO-V3-02 板级配置
#
# 这个文件里的设置会在每次构建时覆盖 IDF 的默认值。
# 想改配置请改这里, 不要直接改 sdkconfig —— sdkconfig 是自动生成的,
# 删掉它就能从本文件重新生成。

# ---------------------------------------------------------------------
# 目标芯片: ESP32-PICO-V3-02 里封的是经典 ESP32 (Xtensa LX6 双核)
# 注意不是 S3/C3/C6 —— 那三个是另一条产品线
#
# 板子身份是实测出来的, 不是看丝印。esptool flash_id 的输出:
#   Chip is ESP32-PICO-V3-02 (revision v3.1)
#   Features: WiFi, BT, Dual Core, 240MHz, Embedded Flash, Embedded PSRAM
#   Manufacturer: 20  Device: 4017   Detected flash size: 8MB
# ---------------------------------------------------------------------
CONFIG_IDF_TARGET="esp32"

# ---------------------------------------------------------------------
# Flash 容量: 8MB
#
# 注意 IDF 对 esp32 的默认值只有 2MB。配小了不会报错, 只会在启动时
# 打一行很容易被忽略的警告:
#   W spi_flash: Detected size(8192k) larger than the size in the
#                binary image header(4096k). Using the size in the binary image header.
# 看到这行 = 固件头配小了, 芯片实际比它大。
# ---------------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# ---------------------------------------------------------------------
# PSRAM: V3-02 封装内有 2MB PSRAM (eFuse 里标了 Embedded PSRAM), 必须开启。
#
# 其余选项保持 IDF 默认, 它们正好匹配 V3-02:
#   SPIRAM_MODE_QUAD = y     quad 模式 (ESP32 只支持 quad)
#   SPIRAM_TYPE      = AUTO  自动识别芯片型号
#   SPIRAM_SPEED     = 40M   与 flash 的 40MHz 同频, 是受支持的组合
#
# 反过来: 若板子实际没有 PSRAM 而误开此项, 会启动时反复重启。
# ---------------------------------------------------------------------
CONFIG_SPIRAM=y

# ---------------------------------------------------------------------
# 分区表: singleapp_large —— app 分区 1.5MB
# IDF 默认的 singleapp 只给 app 1MB, 对带 WiFi + BLE 的固件太紧。
# 我们有 8MB 可用, 换成官方预设的 large 版本 (app 1500K)。
# ---------------------------------------------------------------------
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# ---------------------------------------------------------------------
# 控制台: UART0, 115200
# 板载 CP2102N 接的就是 UART0 (GPIO1=TX / GPIO3=RX),
# USB 线插上去在 Linux 侧就是 /dev/ttyUSB0。
# ---------------------------------------------------------------------
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
