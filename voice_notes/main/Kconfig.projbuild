menu "voice_notes 板级配置"

    # 板子选择。默认值按 IDF target 自动选 —— 所以 `idf.py set-target esp32s3`
    # 之后通常不需要手动进 menuconfig。
    #
    # ⚠️ 这个 choice 必须与 board.h 里的 #if 一一对应。
    #    只加了一边会撞上 board.h 的 #error（刻意的：宁可编译失败，
    #    也不要静默用错引脚 —— 引脚错了可能撞 SPI Flash 直接死机）。
    choice BOARD_SELECT
        prompt "Target board"
        default BOARD_PICO_V3_02   if IDF_TARGET_ESP32
        default BOARD_S3_DEVKITC_1 if IDF_TARGET_ESP32S3
        help
            选择目标开发板。两块板子的引脚、时钟源、PSRAM 模式、console 通路
            全都不同，且 GPIO22/25 在 S3 上物理不存在 —— 所以必须编译期选定，
            不能"改几个数字通用"。

            详细参数与实测依据见 main/board.h。

        config BOARD_PICO_V3_02
            bool "ESP32-PICO-V3-02 (经典 ESP32, 2MB PSRAM, CP2102N)"
        config BOARD_S3_DEVKITC_1
            bool "ESP32-S3-DevKitC-1 N16R8 (8MB PSRAM, 原生 USB)"
    endchoice

    config BOARD_SELECTED_NAME
        string
        default "ESP32-PICO-V3-02"  if BOARD_PICO_V3_02
        default "ESP32-S3-DevKitC-1" if BOARD_S3_DEVKITC_1
        help
            仅供显示。实际的板级参数在 board.h 里，不在这里。

endmenu
