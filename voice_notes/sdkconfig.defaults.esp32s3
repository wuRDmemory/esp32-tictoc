# ══════════════════════════════════════════════════════════════════
# ESP32-S3-CAM (N16R8) 专属配置
#
# 依据：2026-10-04 实测（esptool chip_id / flash_id + 启动日志）
#   Chip is ESP32-S3 (QFN56) (revision v0.2)
#   Features: WiFi, BLE, Embedded PSRAM 8MB (AP_3v3)
#   Detected flash size: 16MB
#   USB mode: USB-Serial/JTAG
#
# 板级引脚/时钟源见 main/board.h
# ══════════════════════════════════════════════════════════════════

CONFIG_IDF_TARGET="esp32s3"

# ── Flash ──
# 实测 16MB —— ⚠️ 不是 8MB。写小了会让分区表只覆盖一半。
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ── PSRAM：八线（octal）──
# ⚠️ 这三行是最容易出错的地方，错了会【反复重启】：
#
#   E quad_psram: PSRAM chip is not connected, or wrong PSRAM line mode
#   E cpu_start: Failed to init external RAM!
#   abort() was called ... Rebooting...
#
# 这个错误信息很有误导性 —— 它读起来像"板子坏了/PSRAM 虚焊"，
# 实际只是模式配错了：Kconfig 默认是 QUAD，而 N16R8 是 OCTAL。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y                 # 八线（默认是 QUAD）
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y          # 64 Mbit = 8MB
CONFIG_SPIRAM_SPEED_80M=y                # 八线常用 80MHz

# ── console：原生 USB 的 USB-Serial-JTAG ──
#
# 为什么不用 UART0：
#   ① cdc_acm 内建于 WSL 内核（CONFIG_USB_ACM=y）→ 【不需要 modprobe】
#   ② 下载模式与运行固件都是 303a:1001，PID 稳定 → 【不用反复重绑】
#   ③ 烧录速度约 1337 kbit/s（CP2102N 只有 643）
#   ④ 完全绕开 CP2102N 的 512 字节缓冲 —— 那是"每 10 分钟丢 0.5 秒"
#      的根源（见 docs/stage2-results.md §7），原生 USB 有望消除它
#
# ⚠️ 也正因为如此，【不要】在这里写 CONFIG_ESP_CONSOLE_UART_TX_GPIO /
#    RX_GPIO —— 那些是 UART 专属的，S3 上 UART0 是 GPIO43/44。
#    照搬经典 ESP32 的配置会把 console 引到不相干的 GPIO（实测踩过：
#    串口完全没有输出）。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
