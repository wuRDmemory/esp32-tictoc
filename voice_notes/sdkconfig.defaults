# ── 芯片 / 板级 ──
# 板子实测为 ESP32-PICO-V3-02（不是型号自报的那个），依据 docs/prd.md §6
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# V3-02 封装内有 2MB PSRAM，实测可用
CONFIG_SPIRAM=y

# app 分区给到 1500K，给后续 WiFi + 缓冲区留余量
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# ── 串口 ──
# 921600 是必须的：裸 PCM 是 32000 B/s，115200 只有 11520 B/s，装不下。
# 推导见 docs/prd.md §7「带宽核对」
#
# ⚠️ 为什么必须走 CUSTOM —— 这是个 Kconfig 坑，实测踩过：
#   ESP_CONSOLE_UART_BAUDRATE 的 prompt 条件是 `if ESP_CONSOLE_UART_CUSTOM`
#   (components/esp_system/Kconfig:413)。
#   若保持默认的 ESP_CONSOLE_UART_DEFAULT，该符号**没有 prompt**，Kconfig
#   视为不可由用户赋值 —— 在这里写 921600 会被**静默丢弃**，回落 115200。
#   症状：编译通过，但裸 PCM 以 3 倍速率发送，必然丢数据。
#   → 必须同时选 CUSTOM，波特率才生效。
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y      # UART0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# 显式钉死 console 引脚。CUSTOM 模式下这些符号才可配，esp32 的默认值
# 恰好就是 1/3，但这里**故意写出来**：console 与裸 PCM 共用 UART0，
# 万一将来默认值变了、把 console 挪到 GPIO 22/25/26，就会和 I²S 三个脚
# 直接冲突 —— 那种 bug 极难定位，不如现在钉死。
CONFIG_ESP_CONSOLE_UART_TX_GPIO=1
CONFIG_ESP_CONSOLE_UART_RX_GPIO=3

# ── 运行时 ──
# rec/wav 命令里会做统计计算，主任务栈给大一点
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# 1000 Hz 让 vTaskDelay 的调度粒度到 1ms
CONFIG_FREERTOS_HZ=1000

# ── 日志 ──
# 阶段 1 只关心我们自己的打印，把底层驱动的 info 关掉避免刷屏
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
