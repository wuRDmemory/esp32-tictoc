# ══════════════════════════════════════════════════════════════════
# 通用配置 —— 与芯片无关的部分放这里
#
# 芯片相关的部分在 sdkconfig.defaults.<target> 里，IDF 会按当前 target
# 自动叠加。所以 `idf.py set-target esp32s3` 之后不需要手动改任何东西。
#
#   本文件              → 通用
#   sdkconfig.defaults.esp32    → ESP32-PICO-V3-02
#   sdkconfig.defaults.esp32s3  → ESP32-S3-DevKitC-1
#
# 板级差异（引脚、时钟源）不在这里，在 main/board.h。
# ══════════════════════════════════════════════════════════════════

# ── 分区表 ──
# app 分区给到 1500K，给后续 WiFi + 缓冲区留余量
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# ── 运行时 ──
# rec/wav 命令里会做统计计算，主任务栈给大一点
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# 1000 Hz 让 vTaskDelay 的调度粒度到 1ms
CONFIG_FREERTOS_HZ=1000

# ── 日志 ──
# 只关心我们自己的打印，把底层驱动的 info 关掉避免刷屏
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
