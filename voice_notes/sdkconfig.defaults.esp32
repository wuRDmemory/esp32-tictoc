# ══════════════════════════════════════════════════════════════════
# ESP32-PICO-V3-02（经典 ESP32）专属配置
#
# 依据：docs/hardware.md §7 的实测（esptool flash_id + 启动日志）
# 板级引脚/时钟源见 main/board.h
# ══════════════════════════════════════════════════════════════════

CONFIG_IDF_TARGET="esp32"

# ── Flash ──
# 实测 8MB（IDF 对 esp32 的默认只有 2MB，必须显式写）
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# ── PSRAM ──
# V3-02 封装内有 2MB PSRAM，实测可用（堆从 295KB 涨到 2.3MB 是硬证据）
# 经典 ESP32 的 PSRAM 是 quad 模式，Kconfig 默认值即正确。
CONFIG_SPIRAM=y

# ── console：UART0 @ 921600 ──
# 921600 是必须的：裸 PCM 是 32000 B/s，115200 只有 11520 B/s，装不下。
# 推导见 docs/prd.md §7「带宽核对」
#
# ⚠️ 为什么必须走 CUSTOM —— 这是个 Kconfig 坑，实测踩过：
#   ESP_CONSOLE_UART_BAUDRATE 的 prompt 条件是 `if ESP_CONSOLE_UART_CUSTOM`
#   (components/esp_system/Kconfig:413)。
#   若保持默认的 ESP_CONSOLE_UART_DEFAULT，该符号**没有 prompt**，Kconfig
#   视为不可由用户赋值 —— 在这里写 921600 会被**静默丢弃**，回落 115200。
#   症状：编译通过，但裸 PCM 以 3 倍速率发送，必然丢数据。
#   → 必须同时选 CUSTOM，波特率才生效。
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y      # UART0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# 显式钉死 console 引脚为 1/3（esp32 的默认值）。
# ⚠️ 这两行是【经典 ESP32 专属】—— 在 S3 上 UART0 是 GPIO43/44，
#    照搬到 S3 会把 console 引到两个不相干的 GPIO 上（实测踩过，
#    表现为"串口完全没有输出"）。这也是把它们从通用 defaults 挪到
#    这里的原因。
CONFIG_ESP_CONSOLE_UART_TX_GPIO=1
CONFIG_ESP_CONSOLE_UART_RX_GPIO=3
